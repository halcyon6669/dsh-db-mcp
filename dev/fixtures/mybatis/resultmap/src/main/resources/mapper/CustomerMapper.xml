<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.customer.CustomerMapper">

    <select id="selectByCode" resultType="com.example.customer.Customer">
        select c.id, c.code, c.name from t_customer c where c.code = #{code}
    </select>

</mapper>
