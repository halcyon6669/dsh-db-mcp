<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.OrderResultMap">

    <resultMap id="orderWithCustomer" type="com.example.order.Order">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <association property="customer" javaType="com.example.customer.Customer"
                     column="customer_code" select="com.example.customer.CustomerMapper.selectByCode"/>
        <collection property="lines" javaType="java.util.List"
                    column="id" select="com.example.line.LineMapper.selectByOrderId"/>
    </resultMap>

    <resultMap id="orderWithRegion" type="com.example.order.Order">
        <id column="id" property="id"/>
        <association property="region" javaType="com.example.region.Region">
            <id column="region_id" property="id"/>
            <result column="region_name" property="name"/>
        </association>
    </resultMap>

    <select id="selectWithCustomer" resultMap="orderWithCustomer">
        select o.id, o.code, o.customer_code from t_order o where o.id = #{id}
    </select>

</mapper>
