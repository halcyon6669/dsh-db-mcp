<mxfile host="app.diagrams.net"><diagram id="zh-page" name="中文"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="dsh-db-mcp 使用指引" style="text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="28" y="10" width="752" height="28" as="geometry"/></mxCell>
<mxCell id="3" value="把 DBeaver 里已有的连接，变成 AI 在对话里能直接用的数据库工具 —— 不用改 DSH 文件，也不用重打连接串" style="text;fontSize=12;align=left;verticalAlign=middle;fontColor=#6b6b6b;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="28" y="38" width="752" height="20" as="geometry"/></mxCell>
<mxCell id="4" value="" style="rounded=1;fillColor=#f6faff;strokeColor=#9dbfe0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="74" width="352" height="414" as="geometry"/></mxCell>
<mxCell id="5" value="① 在面板里准备连接" style="text;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f4e79;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="84" width="324" height="22" as="geometry"/></mxCell>
<mxCell id="6" value="&lt;b&gt;① 安装插件&lt;/b&gt;&lt;br&gt;dsh plugin --profile desktop add dsh-db-mcp" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="112" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="7" value="&lt;b&gt;② 从 DBeaver 导入&lt;/b&gt;&lt;br&gt;读取 data-sources.json，自动解密已存口令" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="186" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="8" value="&lt;b&gt;③ 也可以手工新建&lt;/b&gt;&lt;br&gt;粘 DSN、JDBC URL、TNS 或 .db 路径，先测试再保存" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="260" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="9" value="&lt;b&gt;④ 分组整理&lt;/b&gt;&lt;br&gt;拖拽归组、批量测试、点标题切换视图" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="334" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="10" value="&lt;b&gt;⑤ 按需授权写入&lt;/b&gt;&lt;br&gt;默认只读；打开全局开关后，单源仍可保持只读" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="408" width="324" height="56" as="geometry"/></mxCell>
<mxCell id="11" value="" style="rounded=1;fillColor=#f7fdf8;strokeColor=#a8d5b5;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="428" y="74" width="352" height="414" as="geometry"/></mxCell>
<mxCell id="12" value="② 在对话里提问，AI 直接查库" style="text;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f6b3a;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="84" width="324" height="22" as="geometry"/></mxCell>
<mxCell id="13" value="&lt;b&gt;⑥ 直接提问&lt;/b&gt;&lt;br&gt;「这个库里有哪些表？上个月订单总额是多少？」" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="112" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="14" value="&lt;b&gt;⑦ AI 调工具&lt;/b&gt;&lt;br&gt;自动选中 mcp__db__ 工具，并带上数据源标识符" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="186" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="15" value="&lt;b&gt;⑧ 结果回到对话&lt;/b&gt;&lt;br&gt;表格、行数、耗时；数据库报错原样透传" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="260" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="16" value="&lt;b&gt;⑨ 缩小范围（可选）&lt;/b&gt;&lt;br&gt;session_scope 用标识符限定本会话可见的数据源" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="334" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="17" value="&lt;b&gt;⑩ 继续追问&lt;/b&gt;&lt;br&gt;换统计口径、解释某张表的作用、生成 SQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="408" width="324" height="56" as="geometry"/></mxCell>
<mxCell id="18" value="&lt;b&gt;9 个工具：&lt;/b&gt;list_datasources · list_tables · describe_table · sample_rows&lt;br&gt;execute_sql · explain_query · get_ddl · test_connection · session_scope&lt;br&gt;&lt;b&gt;安全默认：&lt;/b&gt;只读 · 全局写开关 · 逐次审计（logs/audit.jsonl） · 单次最多 200 行" style="rounded=1;fillColor=#fffdf5;strokeColor=#e0c68a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="552" width="760" height="72" as="geometry"/></mxCell>
<mxCell id="19" value="连接就绪" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#8a8a8a;html=1;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="478" width="760" height="62" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;⑪ 可选：让别的 agent 也用这个服务&lt;/b&gt;&lt;br&gt;面板 →「接入其它客户端」：VS Code / Cursor / Claude Code 直接用 HTTP 地址；Claude Desktop / Codex 用 stdio 条目。数据源与只读限制共用，审计与会话限制只在 DSH 内有效" style="text;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;whiteSpace=wrap;html=1;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="34" y="486" width="732" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="en-page" name="English"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="dsh-db-mcp at a glance" style="text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="28" y="10" width="752" height="28" as="geometry"/></mxCell>
<mxCell id="3" value="Turn the connections DBeaver already knows into database tools the agent can use in a conversation — no DSH files to edit, no connection string to retype" style="text;fontSize=12;align=left;verticalAlign=middle;fontColor=#6b6b6b;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="28" y="38" width="752" height="20" as="geometry"/></mxCell>
<mxCell id="4" value="" style="rounded=1;fillColor=#f6faff;strokeColor=#9dbfe0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="74" width="352" height="414" as="geometry"/></mxCell>
<mxCell id="5" value="① Prepare the connection in the panel" style="text;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f4e79;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="84" width="324" height="22" as="geometry"/></mxCell>
<mxCell id="6" value="&lt;b&gt;① Install the plugin&lt;/b&gt;&lt;br&gt;dsh plugin --profile desktop add dsh-db-mcp" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="112" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="7" value="&lt;b&gt;② Import from DBeaver&lt;/b&gt;&lt;br&gt;Reads data-sources.json and decrypts saved passwords" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="186" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="8" value="&lt;b&gt;③ Or add one by hand&lt;/b&gt;&lt;br&gt;Paste a DSN, JDBC URL, TNS or .db path, test, then save" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="260" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="9" value="&lt;b&gt;④ Group the sources&lt;/b&gt;&lt;br&gt;Drag into groups, test in bulk, click the title to switch views" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="334" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="10" value="&lt;b&gt;⑤ Allow writes if you need them&lt;/b&gt;&lt;br&gt;Read-only by default; a source can stay read-only after the global switch is on" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="408" width="324" height="56" as="geometry"/></mxCell>
<mxCell id="11" value="" style="rounded=1;fillColor=#f7fdf8;strokeColor=#a8d5b5;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="428" y="74" width="352" height="414" as="geometry"/></mxCell>
<mxCell id="12" value="② Ask in the conversation" style="text;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f6b3a;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="84" width="324" height="22" as="geometry"/></mxCell>
<mxCell id="13" value="&lt;b&gt;⑥ Just ask&lt;/b&gt;&lt;br&gt;“Which tables live here? What was last month’s revenue?”" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="112" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="14" value="&lt;b&gt;⑦ The agent calls a tool&lt;/b&gt;&lt;br&gt;Picks the mcp__db__ tool and passes the datasource identifier" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="186" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="15" value="&lt;b&gt;⑧ The answer comes back&lt;/b&gt;&lt;br&gt;Table, row count, elapsed time; database errors pass through unchanged" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="260" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="16" value="&lt;b&gt;⑨ Narrow the scope (optional)&lt;/b&gt;&lt;br&gt;session_scope limits this conversation to chosen data sources" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="334" width="324" height="62" as="geometry"/></mxCell>
<mxCell id="17" value="&lt;b&gt;⑩ Keep asking&lt;/b&gt;&lt;br&gt;Change the angle, explain one table, draft the SQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="442" y="408" width="324" height="56" as="geometry"/></mxCell>
<mxCell id="18" value="&lt;b&gt;9 tools:&lt;/b&gt; list_datasources · list_tables · describe_table · sample_rows&lt;br&gt;execute_sql · explain_query · get_ddl · test_connection · session_scope&lt;br&gt;&lt;b&gt;Safe defaults:&lt;/b&gt; read-only · global write switch · one audit line per call (logs/audit.jsonl) · 200 rows per call" style="rounded=1;fillColor=#fffdf5;strokeColor=#e0c68a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="552" width="760" height="72" as="geometry"/></mxCell>
<mxCell id="19" value="connection ready" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#8a8a8a;html=1;" edge="1" parent="1" source="4" target="11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="478" width="760" height="62" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;⑪ Optional: point another agent at the same server&lt;/b&gt;&lt;br&gt;Panel → Connect: VS Code / Cursor / Claude Code take the HTTP URL directly; Claude Desktop / Codex take a stdio entry. Data sources and read-only limits are shared, while the audit log and the conversation limit stay DSH-only" style="text;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;whiteSpace=wrap;html=1;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="34" y="486" width="732" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
